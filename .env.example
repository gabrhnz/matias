# Copia este archivo a .env. No lo subas a git.
# La service role solo la usa el servidor. No la pongas en el navegador.
# La anon key sirve para enviar el código de ingreso. También puede quedar solo en el servidor.

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Si no está, la sesión se firma con la service role.
MATILAB_SECRET=
